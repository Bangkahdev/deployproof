NODE_ENV=development
PORT=3000

# Absolute path recommended for Docker (file:/data/deployproof.db)
DATABASE_URL=file:./dev.db

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=replace_with_random_secret_min_16_chars
DASHBOARD_API_KEY=replace_with_dashboard_key_min_16_chars

# Devnet ONLY. Mainnet is rejected at startup.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base64 of the 64-byte secret key. Create one with: npm run wallet:new (in backend/)
SOLANA_PRIVATE_KEY_BASE64=replace_with_devnet_key

# Optional: without a key, failure analysis jobs are marked FAILED and can be retried later
GEMINI_API_KEY=replace_with_gemini_key
# Check Google's docs for currently supported model names
GEMINI_MODEL=gemini-3.5-flash-lite

FRONTEND_URL=http://localhost:5173

# Optional: extra wallet addresses accepted as memo signers (comma-separated), e.g. a previous wallet after rotation.
# TRUSTED_SIGNER_ADDRESSES=
