generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite keeps enums as validated strings:
//   buildStatus:      SUCCESS | FAILURE
//   processingStatus: PENDING | PROCESSING | COMPLETED | FAILED
//   aiStatus:         PENDING | COMPLETED | FAILED | NOT_REQUIRED
model Deployment {
  id               String          @id @default(uuid())
  repoName         String
  commitHash       String
  buildHash        String?
  buildStatus      String
  processingStatus String          @default("PENDING")
  txSignature      String?
  aiAnalysis       String? // JSON text
  aiStatus         String?
  sanitizedLogs    String? // already sanitized (last 200 lines / 20 KB), FAILURE only
  workflowRunId    String
  runAttempt       Int
  workflowUrl      String?
  errorMessage     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  jobs             ProcessingJob[]

  @@unique([repoName, workflowRunId, runAttempt])
  @@index([buildHash])
  @@index([createdAt])
}

// Simple SQLite-backed persistent job queue (BLOCKCHAIN | AI_ANALYSIS)
model ProcessingJob {
  id                   String     @id @default(uuid())
  deploymentId         String
  deployment           Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  jobType              String
  status               String     @default("PENDING")
  attempts             Int        @default(0)
  lastError            String?
  pendingSignature     String? // signed-but-unconfirmed tx; prevents blind re-sends
  lastValidBlockHeight Int?
  runAfter             DateTime   @default(now())
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([status, runAfter])
  @@index([deploymentId])
}
